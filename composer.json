{
	"name": "mrhenry/gs-uploads",
	"description": "WordPress plugin to store uploads on Google Cloud Storage",
	"homepage": "https://github.com/mrhenry/gs-uploads",
	"keywords": [
		"wordpress"
	],
	"license": "MIT",
	"support": {
		"issues": "https://github.com/mrhenry/gs-uploads/issues",
		"source": "https://github.com/mrhenry/gs-uploads"
	},
	"type": "wordpress-plugin",
	"require": {
		"composer/installers": "^1.0 || ^2.0",
		"google/cloud-storage": "^2.6"
	},
	"archive": {
		"exclude": [
			".git",
			".github",
			".gitattributes",
			".gitignore",
			".coverage-report",
			".DS_Store",
			".editorconfig",
			".fake-gcs-server",
			".phpcs.xml.dist",
			".phpunit-multi-site.xml.dist",
			".phpunit-single-site.xml.dist",
			".phpunit.result.cache",
			".tests",
			".vscode",
			".wp-test-root",
			"tests",
			"vendor",
			"composer.lock"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.4",
		"phpunit/phpunit": "^9"
	}
}
